# ---------------------------------------------------------------------------
# CyberShield AI — Backend Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# ---------------------------------------------------------------------------

APP_ENV=development
DEBUG=true
SECRET_KEY=replace-this-with-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=cybershield_user
DB_PASSWORD=change-this-password
DB_NAME=cybershield_ai

# Set to "true" to instantly demo the app with a local SQLite file instead of
# MySQL (useful if MySQL isn't installed on the judging machine). No code
# changes needed — this is purely a config toggle.
USE_SQLITE_FALLBACK=false

# ---- Threat Intelligence APIs (all optional) ----
# Leave blank to run fully offline on the built-in heuristic + ML engine.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10
